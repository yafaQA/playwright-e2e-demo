{
  "name": "playwright-e2e-demo",
  "version": "1.0.0",
  "description": "Playwright (TypeScript) end-to-end and API test automation demo: page objects, fixtures, CI and HTML reports",
  "private": true,
  "scripts": {
    "test": "playwright test",
    "test:e2e": "playwright test --project=e2e --project=e2e-login",
    "test:api": "playwright test --project=api",
    "test:headed": "playwright test --headed",
    "report": "playwright show-report",
    "lint": "tsc --noEmit"
  },
  "keywords": ["playwright", "typescript", "test-automation", "e2e", "api-testing"],
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  }
}
